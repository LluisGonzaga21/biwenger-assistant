# Copia este archivo a ".env" (sin el ".example") y rellena tus datos.
# El ".env" NUNCA se sube a ningun sitio ni se comparte: se queda solo
# en tu ordenador y el script lo lee en local.

BIWENGER_EMAIL=tu_email@ejemplo.com
BIWENGER_PASSWORD=tu_contraseña

# Opcional. Se detecta solo si estas en una unica liga; si estas en
# varias, o si el auto-detect falla, pon aqui el ID de tu liga
# (lo veras en output/debug/account_leagues.json tras ejecutar
# 01_explorar_api.py, o en la URL cuando entras a tu liga en biwenger.com).
BIWENGER_LEAGUE_ID=

# Opcional. Solo hace falta si el script avisa de que no ha podido
# identificar cual de los equipos de la clasificacion eres tu.
BIWENGER_OWN_TEAM_ID=
